# Copy to .env only when starting without the included private local .env.
SECRET_KEY=change-this-to-a-long-random-string
# DATABASE_URL=postgresql+psycopg://...

BRAND_NAME=HaulChime
TARGET_CITY=Kent
TARGET_STATE=WA
PUBLIC_PHONE=
SITE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

MAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
MAIL_FROM=no-reply@haulchime.local
ADMIN_NOTIFY_EMAIL=owner@example.com

ADMIN_USERNAME=admin
# Generate with:
# python -c "from werkzeug.security import generate_password_hash as g; print(g('change-me'))"
ADMIN_PASSWORD_HASH=

AUTO_ROUTE_LEADS=false
STORAGE_BACKEND=local
MAX_PHOTO_MB=8
MAX_PHOTOS=10
RATE_LIMIT_SUBMISSIONS=20
RATE_LIMIT_WINDOW_SECONDS=3600
SESSION_COOKIE_SECURE=false

LOG_LEVEL=INFO
LOG_FORMAT=pretty
LOG_STACKTRACES=true
IP_HASH_SALT=change-me

# Phone verification is required before a request can be submitted.
PHONE_VERIFICATION_ENABLED=true
REQUIRE_PHONE_VERIFICATION=true
APP_ENV=development
BIRD_API_KEY=
BIRD_OTP_TEMPLATE=bird_otp_verification
BIRD_SMS_FROM=
BIRD_REGION=
DEV_OTP_CODE=123456
PHONE_VERIFICATION_HMAC_SECRET=
PHONE_VERIFICATION_ATTEMPT_TTL_SECONDS=600
PHONE_VERIFICATION_MAX_ATTEMPTS=5
PHONE_VERIFICATION_RESEND_DELAY_SECONDS=60
PHONE_VERIFICATION_MAX_SENDS_PER_QUOTE=2
PHONE_VERIFICATION_MAX_SENDS_PER_PHONE_HOUR=3
PHONE_VERIFICATION_MAX_SENDS_PER_PHONE_DAY=5
PHONE_VERIFICATION_MAX_SENDS_PER_IP_HOUR=8
PHONE_VERIFICATION_MAX_SENDS_PER_IP_DAY=20
PHONE_VERIFICATION_MAX_UNIQUE_PHONES_PER_IP_HOUR=4
PHONE_VERIFICATION_MAX_SENDS_PER_SESSION_HOUR=5
PHONE_VERIFICATION_GLOBAL_DAILY_LIMIT=200
PHONE_VERIFICATION_REUSE_DAYS=30

# --- Smarty (smarty.com) address autocomplete + verification ---
# SECRET key pair from Account -> API Keys. Server-side only; the browser
# talks to /api/address/* and never sees these values.
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
# Bias suggestions toward the states you serve (comma separated, blank = all).
SMARTY_PREFER_STATES=WA
# Per-IP hourly ceiling for type-ahead lookups (protects your subscription).
ADDRESS_LOOKUP_LIMIT_PER_HOUR=300

# --- Photo storage ---
# local = disk. On Railway, attach a Volume and point UPLOAD_DIR at its mount
# path (e.g. /data/uploads) — the container filesystem is wiped on every
# deploy, so photos written anywhere else will vanish.
# s3 = any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2).
STORAGE_BACKEND=local
UPLOAD_DIR=
S3_BUCKET=
S3_PREFIX=photos
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_URL_EXPIRY_SECONDS=900
