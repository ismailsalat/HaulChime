# ---- Virtualenvs and caches ----
backend/.venv/
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/

# ---- Node / build output ----
node_modules/
frontend/dist/
frontend/site.local.json

# ---- Editors and OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
